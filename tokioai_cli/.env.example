# ═══════════════════════════════════════════════════════════════
# TokioAI CLI Configuration
# ═══════════════════════════════════════════════════════════════
#
# Copy this file to ~/.tokioai/.env (global) or ./.env (project-local).
# Project-local .env takes priority over global.
#
# Quick start: uncomment ONE provider section below and set your key.
# Then run: tokio
#
# Or run the setup wizard: tokio --setup

# ─── Provider Selection ───────────────────────────────────────
# Which AI provider to use. Options:
#   anthropic-vertex  (Claude via GCP Vertex AI — needs service account)
#   anthropic         (Claude via API key — console.anthropic.com)
#   openai            (GPT-4o, o3 — platform.openai.com)
#   gemini            (Gemini 2.5/3.x via API key — FREE tier available!)
#   gemini-vertex     (Gemini via GCP Vertex — for Gemini 3.x Pro)
#   kimi              (Moonshot AI K2/K2.7/K3 — platform.moonshot.ai)
#   openrouter        (200+ models via one key — openrouter.ai)
#   ollama            (Local models — free, runs on your machine)
#
# TOKIOAI_PROVIDER=kimi

# ─── Model Selection ─────────────────────────────────────────
# Use an alias (run `tokio` then type `models` to see all):
#   opus, sonnet, haiku       — Claude
#   gpt, gpt4o, o3            — OpenAI
#   flash, gemini3, gemini31  — Gemini
#   k3, k2.7, kimi            — Moonshot AI
#   dual                      — Auto-router: K2.7-code + K3
#   or-k3, or-claude, etc.    — Via OpenRouter
#
# TOKIOAI_MODEL=dual

# ═══════════════════════════════════════════════════════════════
# PROVIDER CONFIGS — uncomment the one you want
# ═══════════════════════════════════════════════════════════════

# ─── Option 1: Kimi (Moonshot AI) ────────────────────────────
# Best value. K2.7-code is fast+cheap, K3 is powerful.
# Get key: https://platform.moonshot.ai/
# Dual mode auto-routes: simple tasks -> K2.7 (cheap), complex -> K3 (smart)
#
# TOKIOAI_PROVIDER=kimi
# TOKIOAI_MODEL=dual
# KIMI_API_KEY=sk-your-key-here

# ─── Option 2: Claude (Anthropic API key) ────────────────────
# Get key: https://console.anthropic.com/
#
# TOKIOAI_PROVIDER=anthropic
# TOKIOAI_MODEL=opus
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ─── Option 3: Claude (Vertex AI — GCP) ──────────────────────
# Requires GCP project with Vertex AI + service account or gcloud auth.
#
# TOKIOAI_PROVIDER=anthropic-vertex
# TOKIOAI_MODEL=opus
# VERTEX_PROJECT=your-gcp-project-id
# VERTEX_REGION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Option 4: Gemini (Google AI — FREE tier!) ───────────────
# Get key: https://aistudio.google.com/apikey
# Free tier: 1500 requests/day for Gemini 2.5 Flash
#
# TOKIOAI_PROVIDER=gemini
# TOKIOAI_MODEL=flash
# GEMINI_API_KEY=AIza-your-key-here

# ─── Option 5: Gemini via Vertex AI (GCP) ────────────────────
# For Gemini 3.x Pro and higher quotas.
#
# TOKIOAI_PROVIDER=gemini-vertex
# TOKIOAI_MODEL=gemini31
# GEMINI_VERTEX_PROJECT=your-gcp-project-id
# GEMINI_VERTEX_REGION=us-central1
# GEMINI_SA_PATH=/path/to/gemini-service-account.json

# ─── Option 6: OpenAI ────────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
#
# TOKIOAI_PROVIDER=openai
# TOKIOAI_MODEL=gpt4o
# OPENAI_API_KEY=sk-proj-your-key-here

# ─── Option 7: OpenRouter (200+ models, one key) ─────────────
# Get key: https://openrouter.ai/keys
# Access Claude, GPT, Gemini, Kimi, Llama, DeepSeek, etc.
#
# TOKIOAI_PROVIDER=openrouter
# TOKIOAI_MODEL=or-claude
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── Option 8: Ollama (local, free) ──────────────────────────
# Install Ollama: https://ollama.com
# Then: ollama pull qwen2.5-coder:14b
#
# TOKIOAI_PROVIDER=ollama
# TOKIOAI_MODEL=qwen
# OLLAMA_HOST=http://localhost:11434

# ═══════════════════════════════════════════════════════════════
# DUAL-MODEL ROUTER (cost optimization)
# ═══════════════════════════════════════════════════════════════
# Routes simple tasks to K2.7-code (cheap) and complex to K3 (smart).
# Typical savings: 60-70% vs using K3 for everything.
#
# DUAL_THRESHOLD=50  # Score 0-100. Higher = more K2.7, lower = more K3.

# ═══════════════════════════════════════════════════════════════
# MULTI-PROVIDER (switch at runtime with `model <alias>`)
# ═══════════════════════════════════════════════════════════════
# Set keys for multiple providers. Switch with: model opus / model k3 / etc.
# Only the active provider's key is used per request.
#
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# KIMI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-v1-...

# ═══════════════════════════════════════════════════════════════
# REMOTE TARGETS (optional — for execute_raspi, execute_gcp, etc.)
# ═══════════════════════════════════════════════════════════════
# RASPI_IP=192.168.1.100
# RASPI_TAILSCALE_IP=100.x.x.x
# RASPI_SSH_USER=pi
# SSH_KEY_RASPI=~/.ssh/id_rsa
#
# GCP_SSH_HOST=your-gcp-vm-ip
# GCP_SSH_USER=user
# SSH_KEY_GCP=~/.ssh/google_compute_engine
#
# ROUTER_IP=192.168.1.1

# ═══════════════════════════════════════════════════════════════
# ADVANCED / SECURITY (usually leave defaults)
# ═══════════════════════════════════════════════════════════════
# MAX_TOKENS=16384
# TOKIO_SECURITY_STRICT=0
# TOKIO_ALLOW_OPENROUTER_PROXY=0
# TOKIO_REQUIRE_EXPLICIT_PROVIDER=0
# TOKIO_PROVIDER_LOCK=
# TOKIO_INIT_REQUIRE_EXPLICIT_KEY=0
